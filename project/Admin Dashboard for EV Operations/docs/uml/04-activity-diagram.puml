@startuml
title EV Charge DZ - Activity Diagram (Ticket Lifecycle)

start

:Issue detected\n(alert or manual report);
:Tenant admin opens "Create Ticket";
:Fill title, station, category,\npriority, assignee, description;

if (Form valid?) then (yes)
  :Compute SLA deadline by priority;
  :Create ticket (status = open);
  :Log activity "ticket created";
else (no)
  :Show validation error;
  stop
endif

if (Assignee selected?) then (yes)
  :Set assigned_to_user_id;
  :Log activity "ticket assigned";
  :Task appears in technician My Tasks;
else (no)
  :Keep ticket unassigned;
endif

:Technician opens My Tasks;

while (Ticket resolved?) is (no)
  :Technician updates status\n(open/in_progress/escalated);
  :Technician submits field report;
  :Update ticket.updated_at;
  :Persist ticket changes;
endwhile (yes)

:Set status = resolved;
:Log activity "ticket resolved";
:Update dashboard metrics and alerts;

stop
@enduml

@startuml
title EV Charge DZ - Activity Diagram (Create Station)

start

:Admin navigates to Stations page;
:Clicks "New Station" button;
:SideDrawer opens with empty form;

if (Super Admin\nwithout tenant context?) then (yes)
  :Select target Tenant\n(Sonelgaz / SAEIG);
else (no)
  :Tenant auto-set from\ncurrent context;
endif

:Fill station details\n(Name, City, Address,\nConnector Type, Power,\nLat/Lng, Connectors, Tariff);

if (Form valid?) then (yes)
  :Generate ID = STN-{timestamp};
  :Set status = "available";
  :Set activeConnectors = 0;
  :Append to stations array;
  :Persist to localStorage\n(stationStore);
  :Update UI station list;
  :Show success toast;
  :Close drawer & reset form;
else (no)
  :Show inline validation error;
  :Keep drawer open;
  stop
endif

:New station visible in\nTable View and Map View;

stop
@enduml
