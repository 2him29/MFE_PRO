@startuml ActivityTicket
title Activity Diagram — Maintenance Ticket Lifecycle

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam dpi 180
skinparam nodesep 12
skinparam ranksep 18

skinparam ActivityBorderColor #2563EB
skinparam ActivityBackgroundColor #EFF6FF
skinparam ActivityFontColor #1E293B
skinparam ActivityArrowColor #64748B
skinparam ActivityDiamondBackgroundColor #FFF7ED
skinparam ActivityDiamondBorderColor #D97706
skinparam ActivityStartColor #2563EB
skinparam ActivityEndColor #0F172A

start

:Anomaly detected\n(station alert or manual report);
:Create Ticket\n(title, category, priority,\nstation, description);
:Set SLA deadline by priority\n(critical < 2h | high < 8h);
:Status → **OPEN**;

fork
  :Notify Admins\n(alert panel + badge);
fork again
  :Log TicketActivity\n(action: "created");
end fork

:Admin reviews ticket;

if (Technician available?) then (yes)
  :Assign ticket to technician;
  :Status → **IN_PROGRESS**;
  :Log TicketActivity (action: "assigned");
  :Technician receives task in /my-tasks;
  :Technician performs on-site intervention;

  repeat
    :Technician updates status\n+ field report;
    :Log TicketActivity (action: "updated");
    if (Issue resolved?) then (yes)
      :Status → **RESOLVED**;
      :Log TicketActivity (action: "resolved");
    else (no)
      if (SLA deadline breached?) then (yes)
        :Status → **ESCALATED**;
        :Log TicketActivity (action: "escalated");
        :Notify Super Admin;
        :Reassign or escalate;
      else (no)
        :Continue intervention;
      endif
    endif
  repeat while (Ticket unresolved?) is (yes)

else (no)
  :Ticket stays OPEN\n(pending assignment);
  :Auto-reminder if SLA near;
endif

:Ticket closed;
:Update Station status (if applicable);
:Generate closure alert;

stop

@enduml
